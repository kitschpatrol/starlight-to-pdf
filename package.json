{
  "name": "starlight-to-pdf",
  "version": "1.4.0",
  "description": "A command-line tool to convert Starlight documentation websites into PDF files.",
  "source": "index.js",
  "type": "module",
  "bin": {
    "starlight-to-pdf": "index.js"
  },
  "scripts": {
    "build": "pnpm check && tsdown ./index.ts --target node24 --minify --no-fixed-extension && cp package.json README.md ./dist",
    "check": "tsc --noEmit",
    "pack": "cd dist && npm pack --pack-destination ~/Dev/npm-test/",
    "publish:prod": "cd dist && npm publish",
    "publish:check": "cd dist && npm publish --dry-run"
  },
  "sideEffects": false,
  "keywords": [
    "starlight",
    "pdf",
    "docs",
    "convert",
    "documentation",
    "astro",
    "cli"
  ],
  "author": "Alexei Gusev (Linkerin)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkerin/starlight-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/Linkerin/starlight-to-pdf/issues"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "puppeteer": "^25.3.0",
    "puppeteer-autoscroll-down": "^2.0.1",
    "tsdown": "0.22.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "puppeteer": "^25.3.0",
    "puppeteer-autoscroll-down": "^2.0.0"
  },
  "dependencies": {
    "yocto-spinner": "1.2.1"
  }
}
