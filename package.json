{
	"name": "@kitschpatrol/starlight-to-pdf",
	"version": "2.0.0-beta.5",
	"description": "CLI tool and TypeScript library to convert Starlight documentation websites into PDF files.",
	"keywords": [
		"starlight",
		"pdf",
		"docs",
		"convert",
		"documentation",
		"astro",
		"cli",
		"npm-package",
		"homebrew-formula"
	],
	"homepage": "https://github.com/kitschpatrol/starlight-to-pdf",
	"bugs": "https://github.com/kitschpatrol/starlight-to-pdf/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/starlight-to-pdf.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"contributors": [
		{
			"name": "Alexei Gusev",
			"email": "gusev@snipshot.dev"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"starlight-to-pdf": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"example": "pnpm build && node ./dist/bin/cli.js spectrum.snipshot.dev -p ./assets --filename spectrum-docs --contents-name 'Table of contents' --exclude '/demo /contacts' --cover --subtitle 'Library documentation' --header --footer --notice 'Spectrum is released under the MIT License.' --print-bg",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'pnpm run release:files' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"release:files": "chagent && pnpm run example",
		"test": "vitest run"
	},
	"dependencies": {
		"@neslinesli93/qpdf-wasm": "^0.3.1",
		"linkifyjs": "^4.4.0",
		"lognow": "^0.8.9",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "^0.8.0",
		"@kitschpatrol/shared-config": "^8.15.0",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"brewpub": "^0.5.1",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.2",
		"publint": "^0.3.25",
		"puppeteer": "^25.18.1",
		"puppeteer-autoscroll-down": "^2.0.1",
		"shx": "^0.4.0",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"vitest": "^5.1.1"
	},
	"peerDependencies": {
		"puppeteer": "^25.3.0",
		"puppeteer-autoscroll-down": "^2.0.1"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
