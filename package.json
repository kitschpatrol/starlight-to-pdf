{
	"name": "@kitschpatrol/starlight-to-pdf",
	"version": "2.0.0-beta.3",
	"description": "CLI tool and TypeScript library to convert Starlight documentation websites into PDF files.",
	"keywords": [
		"starlight",
		"pdf",
		"docs",
		"convert",
		"documentation",
		"astro",
		"cli",
		"npm-package",
		"homebrew-formula"
	],
	"homepage": "https://github.com/kitschpatrol/starlight-to-pdf",
	"bugs": "https://github.com/kitschpatrol/starlight-to-pdf/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/starlight-to-pdf.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"contributors": [
		{
			"name": "Alexei Gusev",
			"email": "gusev@snipshot.dev"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"starlight-to-pdf": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"lognow": "^0.8.5",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.1",
		"publint": "^0.3.25",
		"puppeteer": "^25.13.0",
		"puppeteer-autoscroll-down": "^2.0.1",
		"shx": "^0.4.0",
		"tsdown": "^0.23.1",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"puppeteer": "^25.3.0",
		"puppeteer-autoscroll-down": "^2.0.1"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
